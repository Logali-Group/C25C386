{
  "_version": "1.73.1",
  "sap.app": {
    "id": "com.logaligroup.products",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.3",
      "toolsId": "305ed50c-16fa-4d6a-8b52-1838d7e2a896"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/logali-group/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    
    "handleValidation": true,"flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.logaligroup.products.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "currencies": {
        "type":"sap.ui.model.json.JSONModel",
        "uri":"model/Currencies.json"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.logaligroup.products.view",
        "async": true,
        "viewPath": "com.logaligroup.products.view"
      },
      "routes": [
        {
          "name": "RouteMaster",
          "pattern": ":?query:",
          "target": [
            "TargetMaster"
          ]
        },
        {
          "name": "RouteDetails",
          "pattern": "Products(ID={key}):?query:",
          "target":[
            "TargetMaster",
            "TargetDetails"
          ]
        }
      ],
      "targets": {
        "TargetContainer": {
          "name": "Container"
        },
        "TargetMaster": {
          "parent": "TargetContainer",
          "controlId": "fcl",
          "controlAggregation": "beginColumnPages",
          "name": "Master"
        },
        "TargetDetails": {
          "parent": "TargetContainer",
          "controlId": "fcl",
          "controlAggregation": "midColumnPages",
          "name": "Details"
        }
      }
    },
    "rootView": {
      "viewName": "com.logaligroup.products.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
